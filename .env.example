# NEXUS environment configuration
# Copy this file to .env.local for local development.

# Database
DATABASE_URL=

# Authentication
AUTH_SECRET=

# Email
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# API request security (comma-separated origins)
NEXUS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
