# NEXUS environment configuration
# Copy this file to .env.local for local development.

# Database
DATABASE_URL=

# Authentication
AUTH_SECRET=

# Email
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# API request security (comma-separated origins)
NEXUS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Object storage (server-only; optional until an adapter is enabled)
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Payments (server-only; optional until a provider is enabled)
PAYMENT_PROVIDER=
PAYMENT_SECRET_KEY=
